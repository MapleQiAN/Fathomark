          },
          "exchange": {
            "type": "string",
            "title": "Exchange"
          },
          "research_role": {
            "type": "string",
            "enum": [
              "core",
              "offensive",
              "tactical"
            ],
            "title": "Research Role"
          },
          "horizon": {
            "type": "string",
            "title": "Horizon"
          },
          "research_date": {
            "type": "string",
            "format": "date",
            "title": "Research Date"
          },
          "data_cutoff": {
            "type": "string",
            "format": "date",
            "title": "Data Cutoff"
          },
          "framework_ref": {
            "type": "string",
            "title": "Framework Ref"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "exchange",
          "research_role",
          "horizon",
          "research_date",
          "data_cutoff",
          "framework_ref"
        ],
        "title": "CreateRunRequest"
      },
      "DecisionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "modify",
              "return"
            ],
            "title": "Action"
          },
          "factor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Factor"
          },
          "final_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Score"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "title": "Reason"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "title": "Actor"
          },
          "expected_lock_version": {
            "type": "integer",
            "title": "Expected Lock Version"
          }
        },
        "type": "object",
        "required": [
          "action",
          "reason",
          "actor",
          "expected_lock_version"
        ],
        "title": "DecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestEvidenceRequest": {
        "properties": {
          "evidence": {
