          "expected_lock_version"
        ],
        "title": "ApproveRequest"
      },
      "ArtifactUploadRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "media_type": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Media Type"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 16000000,
            "minLength": 1,
            "title": "Content Base64"
          },
          "manifest_hash": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Manifest Hash"
          },
          "status": {
            "type": "string",
