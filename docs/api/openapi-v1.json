            },
            "type": "array",
            "title": "Proposals"
          }
        },
        "type": "object",
        "required": [
          "proposals"
        ],
        "title": "IngestProposalsRequest"
      },
      "ResolveReviewRequest": {
        "properties": {
          "reason": {
